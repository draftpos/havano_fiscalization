<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Fiscal Day List View -->
        <record id="view_axis_fiscal_day_tree" model="ir.ui.view">
            <field name="name">axis.fiscal.day.list</field>
            <field name="model">axis.fiscal.day</field>
            <field name="arch" type="xml">
                <list string="Fiscal Days" create="false" edit="false">
                    <field name="fiscal_day_no"/>
                    <field name="opened_at"/>
                    <field name="closed_at"/>
                    <field name="invoice_count" string="Invoices"/>
                    <field name="credit_note_count" string="Credit Notes"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'open'"
                           decoration-muted="state == 'closed'"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <!-- Fiscal Day Form View -->
        <record id="view_axis_fiscal_day_form" model="ir.ui.view">
            <field name="name">axis.fiscal.day.form</field>
            <field name="model">axis.fiscal.day</field>
            <field name="arch" type="xml">
                <form string="Fiscal Day Record" create="false" edit="false">
                    <header>
                        <button name="action_close_day" string="Close Day / Generate Z-Report"
                                type="object" class="btn-primary" invisible="state != 'open'"/>
                        <field name="state" widget="statusbar" statusbar_visible="open,closed"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Day Information">
                                <field name="fiscal_day_no"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group string="Timestamps">
                                <field name="opened_at"/>
                                <field name="closed_at"/>
                            </group>
                        </group>
                        <group string="Daily Statistics">
                            <field name="invoice_count"/>
                            <field name="credit_note_count"/>
                        </group>
                        <notebook>
                            <page string="Z-Report Data" invisible="not z_report_response">
                                <field name="z_report_response" widget="text"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action for Fiscal Days -->
        <record id="action_axis_fiscal_days" model="ir.actions.act_window">
            <field name="name">Fiscal Days &amp; Z-Reports</field>
            <field name="res_model">axis.fiscal.day</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No fiscal days recorded yet!
                </p>
                <p>
                    Fiscal days are automatically recorded when opening shifts and closing days via the Axis Virtual Device.
                </p>
            </field>
        </record>

    </data>
</odoo>
