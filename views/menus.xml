<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Actions for Invoices & Credit Notes under Fiscalization App -->
        <record id="action_fiscal_invoices" model="ir.actions.act_window">
            <field name="name">Fiscal Invoices</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="view_id" ref="account.view_invoice_tree"/>
            <field name="search_view_id" ref="account.view_account_invoice_filter"/>
            <field name="domain">[('move_type', '=', 'out_invoice')]</field>
            <field name="context">{'default_move_type': 'out_invoice', 'search_default_fiscalized': 0}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No customer invoices found!
                </p>
                <p>
                    All standard customer invoices and their ZIMRA fiscalization status are tracked here.
                </p>
            </field>
        </record>

        <record id="action_fiscal_credit_notes" model="ir.actions.act_window">
            <field name="name">Fiscal Credit Notes</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="view_id" ref="account.view_invoice_tree"/>
            <field name="search_view_id" ref="account.view_account_invoice_filter"/>
            <field name="domain">[('move_type', '=', 'out_refund')]</field>
            <field name="context">{'default_move_type': 'out_refund'}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No credit notes found!
                </p>
                <p>
                    ZIMRA compliant credit notes with references to original sales and negative amounts appear here.
                </p>
            </field>
        </record>

        <!-- Action to open Fiscalization Settings -->
        <record id="action_fiscalization_config_settings" model="ir.actions.act_window">
            <field name="name">Fiscalization Settings</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">current</field>
            <field name="context">{'module': 'fiscalization'}</field>
        </record>

        <!-- ============================================== -->
        <!-- TOP-LEVEL FISCALIZATION APP & MENUS -->
        <!-- ============================================== -->

        <menuitem id="menu_fiscalization_root"
                  name="Fiscalization"
                  web_icon="fiscalization,static/description/icon.png"
                  groups="account.group_account_invoice"
                  sequence="35"/>

        <!-- Operations Category -->
        <menuitem id="menu_fiscal_operations"
                  name="Operations"
                  parent="menu_fiscalization_root"
                  sequence="10"/>

        <menuitem id="menu_fiscal_invoices"
                  name="Sales Invoices"
                  parent="menu_fiscal_operations"
                  action="action_fiscal_invoices"
                  sequence="10"/>

        <menuitem id="menu_fiscal_credit_notes"
                  name="Credit Notes"
                  parent="menu_fiscal_operations"
                  action="action_fiscal_credit_notes"
                  sequence="20"/>

        <!-- Fiscal Days & Z-Reports Category -->
        <menuitem id="menu_fiscal_days_root"
                  name="Fiscal Days &amp; Z-Reports"
                  parent="menu_fiscalization_root"
                  sequence="20"/>

        <menuitem id="menu_fiscal_days"
                  name="Fiscal Days &amp; Reports"
                  parent="menu_fiscal_days_root"
                  action="action_axis_fiscal_days"
                  sequence="10"/>

        <!-- Configuration Category -->
        <menuitem id="menu_fiscal_config_root"
                  name="Configuration"
                  parent="menu_fiscalization_root"
                  groups="account.group_account_manager"
                  sequence="90"/>

        <menuitem id="menu_fiscal_settings"
                  name="Settings &amp; Devices"
                  parent="menu_fiscal_config_root"
                  action="action_fiscalization_config_settings"
                  sequence="10"/>

    </data>
</odoo>
